rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth()
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function planFieldsUnchanged() {
      let protectedKeys = ['plan', 'trialEndsAt', 'role'];
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(protectedKeys);
    }

    // ── Super Admins ─────────────────────────────────────────
    match /superAdmins/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // ── Config ───────────────────────────────────────────────
    match /config/{docId} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Professionals ────────────────────────────────────────
    match /professionals/{uid} {
      allow get:    if isAuth() && (request.auth.uid == uid || isSuperAdmin());
      allow list:   if isSuperAdmin();
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isSuperAdmin()
                    || (isAuth() && request.auth.uid == uid && planFieldsUnchanged());
      allow delete: if false;
    }

    // ── Patients ─────────────────────────────────────────────
    // read = get + list. A condição é por documento; numa query,
    // o cliente TEM de filtrar por ownerId para a query passar.
    // O super admin não filtra e é autorizado por isSuperAdmin().
    match /patients/{patientId} {
      allow read:   if isAuth() &&
        (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() &&
        (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }

    // ── Analyses ─────────────────────────────────────────────
    match /analyses/{analysisId} {
      allow read:   if isAuth() &&
        (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() &&
        (resource.data.ownerId == request.auth.uid || isSuperAdmin());
    }
  }
}
