rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── Meta ─────────────────────────────────────────────────
    // meta/bootstrap: detecta o primeiro profissional (= admin).
    match /meta/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && !exists(/databases/$(database)/documents/meta/$(docId));
      allow update, delete: if false;
    }

    // ── Professionals (contas que fazem login) ───────────────
    match /professionals/{uid} {
      // Cada profissional lê/edita só o seu próprio perfil.
      allow get:    if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Patients (fichas — não fazem login) ──────────────────
    // Cada paciente pertence ao profissional que o criou (ownerId).
    match /patients/{patientId} {
      allow get, list: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create:     if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── Analyses ─────────────────────────────────────────────
    // Cada análise pertence ao profissional (ownerId) e a um paciente.
    match /analyses/{analysisId} {
      allow get, list: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create:     if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }
  }
}
