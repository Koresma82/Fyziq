rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens de análise, organizadas por paciente.
    // Qualquer profissional autenticado pode ler/escrever;
    // a segregação real é feita nas Firestore rules (ownerId).
    match /analyses/{patientId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size < 12 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
